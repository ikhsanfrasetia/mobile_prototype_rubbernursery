# ===================================================
# KONFIGURASI SERVER & EMAIL NOTIFIKASI SIGMA NURSERY
# ===================================================

# Port Server
PORT=3000

# URL Aplikasi (untuk link dalam email)
APP_URL=http://localhost:3000

# Alamat Email Admin/Penerima Notifikasi Catatan Perbaikan
ADMIN_NOTIFICATION_EMAIL=admin@gmail.com

# ===================================================
# KONFIGURASI SMTP EMAIL PENGIRIM (Contoh: Gmail)
# ===================================================
# Bila menggunakan Gmail:
# 1. Buka https://myaccount.google.com/security
# 2. Aktifkan 2-Step Verification
# 3. Buat App Password (Sandi Aplikasi 16-digit)
# ===================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-app-password
MAIL_FROM="Sigma Nursery System" <your-email@gmail.com>
